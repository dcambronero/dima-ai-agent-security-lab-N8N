supports_strict_tool_calling\":false,\"use_responses_api\":true},\"response\":{\"response\":{\"generations\":[[{\"text\":\"No puedo hacer eso. Pero puedo ayudarte con consultas específicas sobre empleados, finanzas, o cualquier otro tema relacionado con DIMA AI Company. ¿En qué puedo asistirte?\"}]]},\"tokenUsageEstimate\":{\"completionTokens\":35,\"promptTokens\":248,\"totalTokens\":283}}}"}}
